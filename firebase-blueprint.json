{
  "entities": {
    "SiteContent": {
      "title": "SiteContent",
      "description": "Editable bilingual (EN/FR) text override for any section of Safarihoo.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9._\\-]+$",
          "description": "Translation or section key (e.g., hero.title.line1, contact.email)."
        },
        "en": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "English text value."
        },
        "fr": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "French text value."
        },
        "group": {
          "type": "string",
          "maxLength": 32,
          "enum": [
            "hero",
            "hotels",
            "cars",
            "airhelp",
            "trust",
            "destinations",
            "reviews",
            "about",
            "faq",
            "footer",
            "attractions",
            "contact",
            "custom"
          ],
          "description": "Logical section grouping in Admin Panel."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Human-readable field label for the Admin Panel."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of document creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["key", "en", "fr", "group", "label", "createdAt", "updatedAt"]
    },
    "SiteFile": {
      "title": "SiteFile",
      "description": "Stored media asset, PDF guide, or linked file managed via the Admin Panel.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Display filename."
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "MIME type (e.g., image/jpeg, application/pdf)."
        },
        "category": {
          "type": "string",
          "maxLength": 32,
          "enum": ["image", "document", "media", "asset"],
          "description": "File category filter."
        },
        "storageMode": {
          "type": "string",
          "maxLength": 16,
          "enum": ["inline", "external"],
          "description": "Whether the payload is inline base64 dataUrl or an external URL."
        },
        "dataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 750000,
          "description": "Base64 data URL (capped below Firestore 1MB limit) when storageMode is inline."
        },
        "externalUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "External file HTTPS URL when storageMode is external."
        },
        "sizeBytes": {
          "type": "integer",
          "description": "Byte size of the stored or linked file."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional notes describing usage of this file."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last modification."
        }
      },
      "required": [
        "name",
        "mimeType",
        "category",
        "storageMode",
        "dataUrl",
        "externalUrl",
        "sizeBytes",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteLink": {
      "title": "SiteLink",
      "description": "Dynamic navigation, footer, or promotional link managed via the Admin Panel.",
      "type": "object",
      "properties": {
        "labelEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Link label in English."
        },
        "labelFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Link label in French."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Target HTTP/HTTPS URL or internal anchor."
        },
        "placement": {
          "type": "string",
          "maxLength": 32,
          "enum": [
            "header",
            "footer_company",
            "footer_services",
            "footer_resources",
            "footer_legal",
            "custom_bar"
          ],
          "description": "Where on Safarihoo this link appears."
        },
        "openInNewTab": {
          "type": "boolean",
          "description": "Whether clicking opens in a new browser tab."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the link is visible to visitors."
        },
        "order": {
          "type": "integer",
          "description": "Sort priority index."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Internal note or tooltip."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last modification."
        }
      },
      "required": [
        "labelEn",
        "labelFr",
        "url",
        "placement",
        "openInNewTab",
        "active",
        "order",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteAttraction": {
      "title": "SiteAttraction",
      "description": "Curated attraction or tour displayed in the Hotels & Attractions section.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Tour title in English."
        },
        "titleFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Tour title in French."
        },
        "price": {
          "type": "number",
          "description": "Base tour price in USD."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Tour description in English."
        },
        "descriptionFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Tour description in French."
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Short tag in English."
        },
        "tagFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Short tag in French."
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Duration label in English."
        },
        "durationFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Duration label in French."
        },
        "category": {
          "type": "string",
          "maxLength": 24,
          "enum": ["Adventure", "Culture", "Wellness"],
          "description": "Attraction category."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Location label."
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750000,
          "description": "Image URL or inline data URL."
        },
        "bookingUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Destination booking or affiliate link."
        },
        "highlights": {
          "type": "array",
          "description": "Up to 8 English highlights."
        },
        "highlightsFr": {
          "type": "array",
          "description": "Up to 8 French highlights."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the attraction appears publicly."
        },
        "order": {
          "type": "integer",
          "description": "Display order in carousel."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last modification."
        }
      },
      "required": [
        "title",
        "titleFr",
        "price",
        "description",
        "descriptionFr",
        "tag",
        "tagFr",
        "duration",
        "durationFr",
        "category",
        "location",
        "imageUrl",
        "bookingUrl",
        "highlights",
        "highlightsFr",
        "active",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteDestination": {
      "title": "SiteDestination",
      "description": "Curated destination showcased in the Best Destinations 3-card interactive section.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Detail card title in English."
        },
        "titleFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Detail card title in French."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Short destination name shown on carousel cards."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "City and country display label."
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Country name."
        },
        "categories": {
          "type": "array",
          "description": "Up to 4 category tags (Cities, Historic, Beach, Wonders)."
        },
        "mainImage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750000,
          "description": "Primary destination photo URL or inline data URL."
        },
        "thumbnails": {
          "type": "array",
          "description": "1 to 6 gallery thumbnail URLs or inline data URLs."
        },
        "distance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Distance display metric (e.g., 1,200Km)."
        },
        "temp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Temperature metric (e.g., 24° C)."
        },
        "rating": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Rating string (e.g., 4.9)."
        },
        "price": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Formatted starting price (e.g., $1,180)."
        },
        "tag": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Short tag badge in English."
        },
        "tagFr": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Short tag badge in French."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Destination summary in English."
        },
        "descriptionFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Destination summary in French."
        },
        "bookingUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Optional external booking URL."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the destination appears publicly."
        },
        "order": {
          "type": "integer",
          "description": "Display sort index."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "title",
        "titleFr",
        "name",
        "location",
        "country",
        "categories",
        "mainImage",
        "thumbnails",
        "distance",
        "temp",
        "rating",
        "price",
        "tag",
        "tagFr",
        "description",
        "descriptionFr",
        "bookingUrl",
        "active",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteReview": {
      "title": "SiteReview",
      "description": "Traveler testimonial displayed in the Reviews section.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Reviewer display name."
        },
        "role": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Reviewer subtitle/role/city in English."
        },
        "roleFr": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Reviewer subtitle/role/city in French."
        },
        "headline": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Optional bold review headline in English."
        },
        "headlineFr": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Optional bold review headline in French."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "description": "Review body in English."
        },
        "textFr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "description": "Review body in French."
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5."
        },
        "category": {
          "type": "string",
          "maxLength": 24,
          "enum": ["flights", "hotels", "cars", "airhelp"],
          "description": "Travel service category."
        },
        "cardStyle": {
          "type": "string",
          "maxLength": 32,
          "enum": [
            "quote-top",
            "avatar-top-stars",
            "headline-stars",
            "quote-bottom-avatar",
            "cursive-signature",
            "headline-avatars"
          ],
          "description": "Visual card layout preset."
        },
        "avatar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750000,
          "description": "Avatar photo URL or inline data URL."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the review appears publicly."
        },
        "order": {
          "type": "integer",
          "description": "Display sort index."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "name",
        "role",
        "roleFr",
        "headline",
        "headlineFr",
        "text",
        "textFr",
        "rating",
        "category",
        "cardStyle",
        "avatar",
        "active",
        "order",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/site_content/{contentId}": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Bilingual copy overrides and dynamic site settings."
    },
    "/site_files/{fileId}": {
      "schema": { "$ref": "#/entities/SiteFile" },
      "description": "Uploaded or externally linked files managed from the Admin Panel."
    },
    "/site_links/{linkId}": {
      "schema": { "$ref": "#/entities/SiteLink" },
      "description": "Navigation, footer, and promotional links managed from the Admin Panel."
    },
    "/site_attractions/{tourId}": {
      "schema": { "$ref": "#/entities/SiteAttraction" },
      "description": "Dynamic tours and attractions for the Hotels & Attractions experience."
    },
    "/site_destinations/{destId}": {
      "schema": { "$ref": "#/entities/SiteDestination" },
      "description": "Curated destinations for the Best Destinations showcase."
    },
    "/site_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/SiteReview" },
      "description": "Traveler reviews displayed in the Reviews section."
    }
  }
}
